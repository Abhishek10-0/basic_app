{
  "name": "sme-mobile-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @sme/api",
    "dev:admin": "npm run dev -w @sme/admin",
    "dev:user": "npm run dev -w @sme/user-app",
    "dev": "concurrently -n API,ADMIN,USER -c blue,magenta,cyan \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:user\"",
    "build": "npm run build -w @sme/api && npm run build -w @sme/admin && npm run build -w @sme/user-app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps services packages scripts",
    "test": "npm run test -w @sme/api",
    "prisma:generate": "npm run prisma:generate -w @sme/api",
    "prisma:migrate": "npm exec -w @sme/api -- prisma migrate dev",
    "prisma:deploy": "npm run prisma:deploy -w @sme/api",
    "prisma:studio": "npm run prisma:studio -w @sme/api",
    "seed:admin": "npm run seed:admin -w @sme/api",
    "seed": "npm run seed -w @sme/api",
    "db:local": "node scripts/local-db.mjs",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/user-app/app/**/*.tsx\" \"services/api/{src,tests,prisma}/**/*.ts\" \"packages/*/src/*.ts\" \"scripts/*.mjs\"",
    "test:browser": "node scripts/browser-check.mjs",
    "eas:android": "npx eas-cli@latest build --platform android --profile production"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^3.10.0",
    "@sme/config": "*",
    "@sme/shared": "*",
    "@sme/types": "*",
    "@sme/ui": "*",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.65.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  }
}
